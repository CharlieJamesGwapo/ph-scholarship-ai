# Option A: Google Gemini directly (has a free tier). Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Option B: Vercel AI Gateway (used when no Google key is set)
# AI_GATEWAY_API_KEY=

# Optional: override the model (e.g. gemini-3.8-flash, or "openai/gpt-5-mini" through the gateway)
# AI_MODEL=
