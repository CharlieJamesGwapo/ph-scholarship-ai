# Option A: Google Gemini directly (has a free tier). Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Option B: Vercel AI Gateway (used when no Google key is set)
# AI_GATEWAY_API_KEY=

# Optional: the model, or several separated by commas to try in order when one is overloaded
# (use names your key can access in AI Studio; through the gateway use "provider/model" names)
# AI_MODEL=gemini-3.8-flash

# Optional: Gemini thinking depth (minimal, low, medium, high). Default low; gemini-3.8-flash does not accept minimal.
# AI_THINKING_LEVEL=low
